{
  "description": "Deterministic gates for live-style-guide-harness projects: the theme build before a commit, and a setup check at session start.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-gate.mjs\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-check.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
